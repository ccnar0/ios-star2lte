From: ccnar0
Subject: [PATCH] xnu: add STAR2LTE board target (Galaxy S9+, Exynos 9810)

Add a selectable STAR2LTE machine config and the board constants for the
Galaxy S9+ (SM-G965F, Exynos 9810). The target reuses the existing 4 KiB
page / 39-bit VA / Cortex-A53 A5XELTE scaffolding, but builds for the
Cortex-A55, starts one CPU, points at the 0xcc000000 DECON buffer, and
keeps all early console output below y=1480 because the panel's top half
is physically damaged. The Exynos 7580 GPIO, touch and eMMC probes are
disabled for this board; no UFS root path is added yet.

diff --git a/bsd/conf/Makefile.template b/bsd/conf/Makefile.template
index 7dee125..147299a 100644
--- a/bsd/conf/Makefile.template
+++ b/bsd/conf/Makefile.template
@@ -45,7 +45,7 @@ CFLAGS+= -include meta_features.h -DDRIVER_PRIVATE \
 SFLAGS+= -include meta_features.h
 
 # This provider is built into SWEET; other boards use their normal kext.
-ifneq ($(filter $(CURRENT_MACHINE_CONFIG),SWEET A5XELTE HEROLTE),)
+ifneq ($(filter $(CURRENT_MACHINE_CONFIG),SWEET A5XELTE HEROLTE STAR2LTE),)
 SWEET_PTHREAD_ROOT = $(SRCROOT)/bsd/pthread/sweet_libpthread
 SWEET_PTHREAD_INC = -I$(SWEET_PTHREAD_ROOT) -I$(SWEET_PTHREAD_ROOT)/private -I$(SWEET_PTHREAD_ROOT)/include
 sweet_pthread_init.o_INCFLAGS = $(SWEET_PTHREAD_INC)
