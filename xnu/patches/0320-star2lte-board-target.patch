diff --git a/pexpert/arm/pe_serial.c b/pexpert/arm/pe_serial.c
index ed7dccd..e74de91 100644
--- a/pexpert/arm/pe_serial.c
+++ b/pexpert/arm/pe_serial.c
@@ -717,6 +717,13 @@ extern unsigned char iso_font[256 * 16];
 #define FBCON_FG        0xffffffffu
 #define FBCON_BG        0xff000000u
 
+#if defined(A5XELTE)
+/* Keep output below a damaged panel area (0 on healthy panels). */
+#define FBCON_FIRST_ROW A5XELTE_FB_FBCON_FIRST_ROW
+#else
+#define FBCON_FIRST_ROW 0
+#endif
+
 static volatile uint32_t *fbcon_base;
 static uint32_t fbcon_width, fbcon_height, fbcon_stride;
 static uint32_t fbcon_cols, fbcon_rows, fbcon_col, fbcon_row;
@@ -736,18 +743,20 @@ static void
 fbcon_newline(void)
 {
 	fbcon_col = 0;
-	fbcon_row = (fbcon_row + 1) % fbcon_rows;
+	fbcon_row = FBCON_FIRST_ROW +
+	    (fbcon_row - FBCON_FIRST_ROW + 1) % fbcon_rows;
 	fbcon_clear_row(fbcon_row);
-	fbcon_clear_row((fbcon_row + 1) % fbcon_rows);
+	fbcon_clear_row(FBCON_FIRST_ROW + (fbcon_row - FBCON_FIRST_ROW + 1) % fbcon_rows);
 }
 
 static void
 fbcon_init(void)
 {
 	fbcon_cols = fbcon_width / (8 * FBCON_SCALE);
-	fbcon_rows = fbcon_height / (16 * FBCON_SCALE);
-	fbcon_col = fbcon_row = 0;
-	for (uint32_t r = 0; r < fbcon_rows; r++) {
+	fbcon_rows = fbcon_height / (16 * FBCON_SCALE) - FBCON_FIRST_ROW;
+	fbcon_col = 0;
+	fbcon_row = FBCON_FIRST_ROW;
+	for (uint32_t r = FBCON_FIRST_ROW; r < FBCON_FIRST_ROW + fbcon_rows; r++) {
 		fbcon_clear_row(r);
 	}
 }
