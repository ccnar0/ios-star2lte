diff --git a/osfmk/arm64/sweet_early.c b/osfmk/arm64/sweet_early.c
index d6bd6a4..ed513a6 100644
--- a/osfmk/arm64/sweet_early.c
+++ b/osfmk/arm64/sweet_early.c
@@ -19,7 +19,7 @@
 #define A5_COL_WIDTH (8u * A5_SCALE)
 #define A5_COLS (A5XELTE_FB_WIDTH / A5_COL_WIDTH)
 extern unsigned char iso_font[256 * 16];
-static unsigned int a5_row = 4, a5_col, a5_active = 1, a5_panicking;
+static unsigned int a5_row = A5XELTE_FB_TEXT_FIRST_ROW, a5_col, a5_active = 1, a5_panicking;
 
 static void
 a5_clear_row(void)
@@ -44,7 +44,9 @@ sweet_early_putc(char c)
 	}
 	if (c == '\n' || a5_col >= A5_COLS) {
 		a5_col = 0;
-		a5_row = (a5_row + 1) % (A5XELTE_FB_HEIGHT / A5_ROW_HEIGHT);
+		a5_row = A5XELTE_FB_TEXT_FIRST_ROW +
+		    ((a5_row - A5XELTE_FB_TEXT_FIRST_ROW + 1) %
+		     (A5XELTE_FB_HEIGHT / A5_ROW_HEIGHT - A5XELTE_FB_TEXT_FIRST_ROW));
 		a5_clear_row();
