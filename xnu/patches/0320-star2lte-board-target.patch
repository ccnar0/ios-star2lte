+++ b/pexpert/pexpert/arm64/A5XELTE.h
@@ -26,6 +26,40 @@
 #define A5XELTE_MARKER_PA             0x8ffff100
 /* S-Boot starts on the Cortex-A53 "Apollo" cluster, Aff1 = 1. */
 #define A5XELTE_BOOT_MPIDR            0x100
+/* Rows are absolute pixel Y coordinates. The panel is not damaged here. */
+#define A5XELTE_FB_TEXT_FIRST_ROW     4
+#define A5XELTE_FB_FBCON_FIRST_ROW    0
+#define A5XELTE_FB_STAGE_ROW1         88
+#define A5XELTE_FB_STAGE_ROW2         120
+#define A5XELTE_FB_STAGE_ROW3         152
+#define A5XELTE_FB_STAGE_ROW4         184
+#define A5XELTE_FB_STAGE_ROW5         216
+#define A5XELTE_FB_TEXT_ENTRY_Y       256
+#define A5XELTE_FB_TEXT_MMU_Y         288
+#elif defined(ARM64_BOARD_CONFIG_STAR2LTE)
+/* Galaxy S9+ SM-G965F: S-Boot leaves DECON_F scanning out this buffer. */
+#define STAR2LTE                      1
+/* CPU0 only for the first bring-up. */
+#define SWEET_SMP_MAX_CPUS            1
+#define A5XELTE_FB_PA                 0xcc000000
+#define A5XELTE_FB_WIDTH              1440
+#define A5XELTE_FB_HEIGHT             2960
+#define A5XELTE_FB_STRIDE             5760
